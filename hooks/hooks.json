{
  "description": "client-dossier: protocol reminder, sources guard, update-before-handoff check",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-sources.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
